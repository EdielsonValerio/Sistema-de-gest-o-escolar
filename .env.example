# Copie para .env e ajuste. NUNCA versione o arquivo .env real.
DJANGO_DEBUG=True
# Gere uma chave própria: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Banco PostgreSQL instalado nesta máquina (recomendado). Sem DB_NAME/DATABASE_URL o sistema usa SQLite (só dev).
DB_NAME=escola
DB_USER=escola_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Alternativa às variáveis DB_*: DATABASE_URL=postgres://usuario:senha@localhost:5432/escola
DATABASE_URL=
# Em produção (DEBUG=False):
# DJANGO_SECURE_COOKIES=True
# DJANGO_SSL_REDIRECT=True

# Cobrança bancária (boleto com Pix). Opcionais, mas recomendados em produção:
# Chave que cifra as chaves de API dos bancos no banco de dados. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sem ela, usa-se uma chave derivada de DJANGO_SECRET_KEY (trocar a SECRET_KEY exigirá reinformar as chaves de API).
BILLING_CRYPTO_KEY=
# Endereço público HTTPS do sistema (usado para mostrar a URL do webhook que o banco chamará). Ex.: https://escola.exemplo.com.br
DJANGO_SITE_URL=

# Endurecimento HTTP (produção)
# DJANGO_PROXY_HTTPS=True            # atrás de proxy reverso HTTPS (Nginx etc.) que envia X-Forwarded-Proto
# DJANGO_SSL_REDIRECT=True           # redireciona HTTP -> HTTPS
# DJANGO_HSTS_SEGUNDOS=31536000      # HSTS; comece com 3600 e aumente depois de validar o HTTPS
# DJANGO_CSP_SOMENTE_RELATAR=True    # CSP em modo teste (só relata no console do navegador)

