# Copie para .env e ajuste. NUNCA versione o arquivo .env real.
DJANGO_DEBUG=True
# Gere uma chave própria: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Vazio = SQLite local (db.sqlite3). Para PostgreSQL:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/escola
DATABASE_URL=
# Em produção (DEBUG=False):
# DJANGO_SECURE_COOKIES=True
# DJANGO_SSL_REDIRECT=True
